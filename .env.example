# ============================================================================
# LOCAL DEV: copy this file to .env and fill in real values.
# VERCEL: add every one of these under Project Settings -> Environment
# Variables. Vars WITHOUT the VITE_ prefix are server-only (used by /api
# functions) and are never bundled into the frontend. Vars WITH the VITE_
# prefix are baked into the public frontend bundle at build time — never put
# a secret key behind VITE_.
# ============================================================================

# --- Supabase (frontend — safe to expose) ----------------------------------
# Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Dashboard -> Project Settings -> API -> anon public key
# Safe to expose: Row Level Security in supabase/schema.sql is what actually
# protects data, not the secrecy of this key.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (server-only — NEVER expose, no VITE_ prefix) -----------------
# Dashboard -> Project Settings -> API -> service_role key.
# Used only inside /api/*.js (admin-stats, stripe-webhook) to bypass RLS for
# trusted server-side operations (reading aggregate stats, writing billing
# status from a verified webhook). If this leaks, an attacker has full
# read/write access to every table — treat it like a database root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Stripe (frontend — safe to expose) -------------------------------------
# Dashboard -> Developers -> API keys -> Publishable key (starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Stripe (server-only — NEVER expose) ------------------------------------
# Dashboard -> Developers -> API keys -> Secret key (starts with sk_)
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard -> Product catalog -> your $9.99/mo Price -> Price ID (price_xxx)
STRIPE_PRO_PRICE_ID=price_xxx
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
# (starts with whsec_). Locally, this comes from `stripe listen` instead —
# see README "Stripe webhook setup".
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- App URLs ----------------------------------------------------------------
# Used to build Stripe Checkout/Portal success & cancel redirect URLs.
# Local: http://localhost:5173   Production: https://your-app.vercel.app
VITE_APP_URL=http://localhost:5173

# --- Referral -----------------------------------------------------------------
# Your broker affiliate link, shown on the in-app Referral page.
VITE_BROKER_AFFILIATE_URL=https://broker.example.com/?ref=your-affiliate-id
